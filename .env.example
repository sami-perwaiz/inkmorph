# Canonical production URL — must use HTTPS (required for OAuth, sitemap, and security headers).
# Example: https://inkmorph.com
NEXT_PUBLIC_SITE_URL=

# Google OAuth 2.0 Web Client ID (Google Cloud Console → APIs & Services → Credentials)
# Authorized JavaScript origins must include your local and production URLs, e.g.:
#   http://localhost:3000
#   https://your-domain.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
