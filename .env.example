# Canonical production URL — must use HTTPS (required for OAuth, sitemap, and SEO).
# Production: https://inkmorph-design.vercel.app
NEXT_PUBLIC_SITE_URL=https://inkmorph-design.vercel.app

# HMAC secret for signed daily-download limit cookies (set in Vercel production).
DOWNLOAD_LIMIT_SECRET=

# Firebase Web SDK — project: inkmorph-8ff91
# Firebase Console → Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inkmorph-8ff91.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inkmorph-8ff91
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inkmorph-8ff91.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Legacy Google OAuth client ID — no longer used by auth (Firebase handles Google sign-in).
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
